<style>
:root{--bg:#080713;--panel:#111020;--panel2:#17142a;--line:rgba(167,139,250,.17);--text:#f8f7ff;--muted:#9b98b4;--purple:#8b5cf6;--purple2:#6d28d9;--blue:#38bdf8;--nav-h:68px}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
body{padding-top:env(safe-area-inset-top);transition:background .2s,color .2s}
body.light{--bg:#f4f2fb;--panel:#fff;--panel2:#ece8f8;--line:rgba(109,40,217,.15);--text:#19142b;--muted:#77718e}
button,input{font:inherit}button{cursor:pointer;color:inherit}
img{display:block;max-width:100%}
::-webkit-scrollbar{display:none}
#mainContent{height:100dvh;overflow-y:auto;overflow-x:hidden;padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 18px);scroll-behavior:smooth}
.shell{width:100%;max-width:760px;margin:auto;padding:0 14px}
.header{position:sticky;top:0;z-index:40;padding:9px 14px 11px;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(22px);border-bottom:1px solid var(--line)}
.topline{display:flex;align-items:center;justify-content:space-between;gap:10px}
.brand{display:flex;align-items:center;gap:8px;font-weight:950;letter-spacing:1.3px;font-size:21px}
.brand-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(140deg,#a855f7,#4f46e5);box-shadow:0 0 25px #7c3aed50;color:#fff}
.brand span:last-child{background:linear-gradient(100deg,#fff,#b7a0ff);background-clip:text;color:transparent}
.top-actions{display:flex;gap:8px;align-items:center}
.icon-btn{height:38px;width:38px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;background:var(--panel);color:var(--text)}
.user-menu{position:relative}
.user-dropdown{position:absolute;right:0;top:45px;width:190px;padding:7px;background:var(--panel);border:1px solid var(--line);border-radius:15px;box-shadow:0 18px 50px #0008;display:none;z-index:90}
.user-dropdown.show{display:block}
.user-dropdown a{display:flex;gap:10px;padding:11px 10px;text-decoration:none;color:var(--text);font-size:13px;border-radius:9px}
.user-dropdown a:hover{background:var(--panel2)}
.tabs{display:flex;gap:5px;padding:5px;margin-top:12px;border-radius:14px;background:var(--panel);border:1px solid var(--line)}
.tab-btn{flex:1;min-height:36px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-size:12px;font-weight:800}
.tab-btn.active{background:linear-gradient(120deg,#7c3aed,#4f46e5);color:white;box-shadow:0 5px 18px #6d28d944}
.search-row{display:flex;align-items:center;gap:8px;margin-top:10px}
.searchbox{display:flex;align-items:center;gap:9px;flex:1;min-width:0;padding:0 13px;height:42px;border:1px solid var(--line);border-radius:14px;background:var(--panel);color:var(--muted)}
.searchbox input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font-size:13px}
.searchbox input::placeholder{color:var(--muted)}
.search-clear{border:0;background:none;color:var(--muted);display:none}
main section{margin-top:22px}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 11px}
.section-title{font-size:16px;font-weight:900;letter-spacing:-.25px;display:flex;align-items:center;gap:8px}
.section-title i{color:#a78bfa}
.see-all{font-size:11px;color:#b6a2ff;border:0;background:none;font-weight:800}
.hero-wrap{padding-top:13px}
.hero{height:clamp(285px,87vw,410px);max-height:420px;position:relative;overflow:hidden;border-radius:23px;background:linear-gradient(140deg,#201640,#0c122b);border:1px solid #a78bfa30;isolation:isolate;box-shadow:0 15px 50px #0005}
.hero-backdrop{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;opacity:.76;transition:opacity .3s}
.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,#080713 2%,rgba(8,7,19,.83) 26%,rgba(8,7,19,.08) 78%),linear-gradient(90deg,rgba(8,7,19,.38),transparent)}
.hero-content{position:absolute;left:18px;right:18px;bottom:18px}
.eyebrow{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:7px;background:#7c3aed;color:#fff;font-size:9px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
.hero h2{font-size:clamp(25px,7vw,37px);line-height:1.03;font-weight:950;letter-spacing:-.8px;margin:10px 0 7px;text-shadow:0 3px 15px #0008}
.hero p{font-size:12px;line-height:1.45;color:#e0dced;max-width:330px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hero-actions{display:flex;align-items:center;gap:9px;margin-top:13px}
.primary-btn,.secondary-btn{border:0;border-radius:12px;padding:11px 15px;font-size:12px;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.primary-btn{background:linear-gradient(120deg,#9333ea,#4f46e5);color:#fff;box-shadow:0 7px 22px #7c3aed50}
.secondary-btn{background:#ffffff17;border:1px solid #ffffff2a;color:#fff;backdrop-filter:blur(10px)}
.hero-dots{position:absolute;right:16px;top:15px;display:flex;gap:5px}
.hero-dot{width:6px;height:6px;border-radius:9px;background:#ffffff70;border:0}
.hero-dot.active{width:18px;background:#c4b5fd}
.quick-cats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:14px}
.quick-cat{border:1px solid var(--line);border-radius:15px;background:linear-gradient(150deg,var(--panel),var(--panel2));padding:13px 4px 11px;display:flex;align-items:center;flex-direction:column;gap:8px;font-size:10px;font-weight:800;color:var(--text)}
.quick-cat i{font-size:19px;color:#a78bfa}
.quick-cat:nth-child(2) i{color:#38bdf8}.quick-cat:nth-child(3) i{color:#fbbf24}.quick-cat:nth-child(4) i{color:#fb7185}
.horizontal-scroll{display:flex;gap:11px;overflow-x:auto;scroll-snap-type:x mandatory;padding:1px 0 8px}
.movie-card{flex:0 0 112px;width:112px;min-width:0;position:relative;cursor:pointer;scroll-snap-align:start}
.movie-card .poster{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:13px;background:var(--panel2);border:1px solid var(--line);box-shadow:0 7px 18px #0003}
.movie-card:active{transform:scale(.98)}
.movie-card .info{padding:7px 2px 0}
.movie-card .info h4{font-size:11px;line-height:1.35;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.movie-card .meta{display:flex;align-items:center;gap:5px;margin-top:4px;font-size:10px;color:var(--muted)}
.movie-card .meta .rating{color:#fbbf24;font-weight:900}
.poster-wrap{position:relative}
.badge-year,.badge-type{position:absolute;top:7px;font-size:9px;font-weight:900;padding:4px 6px;border-radius:6px;z-index:1}
.badge-year{left:6px;background:#7c3aedeb;color:#fff}.badge-type{right:6px;background:#080713c9;color:#fff}
.card-actions{position:absolute;right:6px;bottom:6px;display:flex;gap:5px;z-index:3}
.card-actions button{width:29px;height:29px;border:1px solid #ffffff30;border-radius:50%;background:#080713bd;color:#fff;backdrop-filter:blur(8px);font-size:11px}
.card-actions .fav-btn{color:#fb7185}.card-actions .list-btn{color:#93c5fd}
.grid-movies{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px 10px}
.grid-movies .movie-card{width:auto;min-width:0}
.grid-movies .movie-card .info h4{font-size:11px}
.grid-movies .movie-card .poster{border-radius:12px}
.grid-movies .card-actions{gap:4px}
.grid-movies .card-actions button{width:27px;height:27px}
.genre-row{display:flex;gap:7px;overflow-x:auto;margin:0 0 13px}
.genre-chip{white-space:nowrap;border:1px solid var(--line);background:var(--panel);color:var(--muted);border-radius:999px;padding:8px 12px;font-size:11px;font-weight:800}
.genre-chip.active{background:#7c3aed;color:#fff;border-color:#7c3aed}
.page-intro{padding:18px 0 10px}
.page-intro h2{font-size:25px;font-weight:950;letter-spacing:-.7px}
.page-intro p{font-size:12px;color:var(--muted);margin-top:5px}
.load-more{display:flex;justify-content:center;padding:20px 0}
.load-more button{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:12px 20px;font-size:12px;font-weight:900;color:var(--text)}
.load-more button:disabled{opacity:.5}
.empty-msg{grid-column:1/-1;color:var(--muted);font-size:12px;padding:18px 0}
.skeleton{aspect-ratio:2/3;border-radius:12px;background:linear-gradient(90deg,var(--panel) 25%,var(--panel2) 50%,var(--panel) 75%);background-size:200% 100%;animation:shimmer 1.3s infinite}
@keyframes shimmer{to{background-position:-200% 0}}
.bottom-nav{position:fixed;z-index:80;bottom:0;left:0;right:0;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(24px);border-top:1px solid var(--line)}
.nav-inner{max-width:600px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:47px;border:0;background:none;color:var(--muted);font-size:9px;font-weight:800}
.nav-item i{font-size:18px}
.nav-item.active{color:#c4b5fd}
.nav-item.active i{filter:drop-shadow(0 0 8px #8b5cf6)}
#bannerApp{display:none;position:fixed;bottom:calc(var(--nav-h) + 9px + env(safe-area-inset-bottom));left:10px;right:10px;z-index:75;padding:10px;border-radius:17px;border:1px solid #a78bfa55;background:var(--panel);box-shadow:0 12px 35px #0008}
.banner-row{display:flex;align-items:center;gap:9px}
.banner-logo-img{width:36px;height:36px;border-radius:10px;object-fit:cover;background:var(--panel2)}
.banner-copy{flex:1;min-width:0}.banner-titulo{font-size:11px;font-weight:900}.banner-sub{font-size:9px;color:var(--muted);margin-top:3px}
.banner-install-btn{border:0;border-radius:10px;background:linear-gradient(120deg,#9333ea,#4f46e5);color:white;padding:10px 12px;font-size:11px;font-weight:900;white-space:nowrap}
.close-banner{width:28px;height:28px;border:0;border-radius:8px;background:var(--panel2);color:var(--muted)}
.toast{position:fixed;z-index:999;left:50%;bottom:calc(var(--nav-h) + 20px + env(safe-area-inset-bottom));transform:translateX(-50%);background:#19152a;border:1px solid #8b5cf6;color:#fff;padding:11px 16px;border-radius:12px;font-size:12px;font-weight:800;box-shadow:0 8px 25px #0008;max-width:90%;text-align:center}
@media(min-width:600px){.shell{padding:0 22px}.header{padding-left:max(18px,calc((100% - 716px)/2));padding-right:max(18px,calc((100% - 716px)/2))}.movie-card{flex-basis:130px;width:130px}.grid-movies{grid-template-columns:repeat(4,minmax(0,1fr))}.hero{height:390px}}
@media(max-width:360px){.shell{padding:0 11px}.header{padding-left:11px;padding-right:11px}.movie-card{flex-basis:100px;width:100px}.quick-cats{gap:5px}.quick-cat{font-size:9px}.hero-content{left:14px;right:14px;bottom:14px}.hero h2{font-size:25px}}
</style>
</head>
