  const q = new URLSearchParams({path,...params});
  const url = 'https://tely-xi.vercel.app/api/tmdb?' + q;
  const response = await fetchConProxy(url);
  const data = await response.json();
  if (data && data.success === false) throw new Error(data.message || 'La API TMDB devolvió un error');
  return data;
}
function getImagenUrl(path,size='w342'){return path?'https://image.tmdb.org/t/p/'+size+path:PLACEHOLDER;}
function itemDesdeTMDB(x,tipo='pelicula'){return{id:x.id,tmdb_id:x.id,titulo:x.title||x.name||'Sin título',anio:(x.release_date||x.first_air_date||'').slice(0,4)||'N/D',portada:getImagenUrl(x.poster_path,'w342'),fondo:getImagenUrl(x.backdrop_path,'w1280'),puntuacion:x.vote_average?Number(x.vote_average).toFixed(1):'N/A',tipo,overview:x.overview||''};}
function mostrarToast(msg,tipo='success'){const old=document.querySelector('.toast');if(old)old.remove();const t=document.createElement('div');t.className='toast';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),2400);}
function irALogin(){location.href='login.html';}
function cerrarSesion(){auth.signOut().then(()=>location.reload()).catch(()=>mostrarToast('No se pudo cerrar sesión','error'));}
function toggleUserMenu(){document.getElementById('userDropdown').classList.toggle('show');}
document.addEventListener('click',e=>{if(!e.target.closest('.user-menu'))document.getElementById('userDropdown')?.classList.remove('show');});
auth.onAuthStateChanged(user=>{document.getElementById('loginBtn').style.display=user?'none':'flex';document.getElementById('logoutBtn').style.display=user?'flex':'none';if(user){cargarFavoritos();cargarMiLista();}else{document.getElementById('favoritosContainer').innerHTML='<p class="empty-msg">Inicia sesión para ver tus favoritos</p>';document.getElementById('miListaContainer').innerHTML='<p class="empty-msg">Inicia sesión para ver tu lista</p>';}});

function toggleTheme(){document.body.classList.toggle('light');const light=document.body.classList.contains('light');localStorage.setItem('theme',light?'light':'dark');document.getElementById('themeBtn').innerHTML=`<i class="fa-solid fa-${light?'moon':'sun'}"></i>`;}
(function(){const light=localStorage.getItem('theme')==='light';document.body.classList.toggle('light',light);document.getElementById('themeBtn').innerHTML=`<i class="fa-solid fa-${light?'moon':'sun'}"></i>`;})();
function guardarEstado(tab){try{sessionStorage.setItem('tabActiva',tab);}catch(e){}}
function restaurarEstado(){try{return sessionStorage.getItem('tabActiva')||'inicio';}catch(e){return'inicio';}}
function guardarScroll(){try{sessionStorage.setItem('scrollPos',document.getElementById('mainContent').scrollTop);}catch(e){}}
function restaurarScroll(){try{document.getElementById('mainContent').scrollTop=parseInt(sessionStorage.getItem('scrollPos'))||0;}catch(e){}}

function cambiarTab(tab){['inicio','peliculas','series'].forEach(t=>{document.getElementById('tab'+t[0].toUpperCase()+t.slice(1)).style.display=t===tab?'block':'none';});document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('.nav-item[data-nav]').forEach(b=>b.classList.toggle('active',b.dataset.nav===tab));guardarEstado(tab);if(tab==='inicio')cargarInicio();if(tab==='peliculas'&&!document.getElementById('gridPeliculas').children.length)cargarPeliculas(1);if(tab==='series'&&!document.getElementById('gridSeries').children.length)cargarSeries(1);document.getElementById('mainContent').scrollTop=0;}
function crearTarjeta(item,esSerie=false){const div=document.createElement('article');div.className='movie-card';const id=String(item.tmdb_id||item.id);const tipo=esSerie||item.tipo==='serie'?'serie':'pelicula';div.innerHTML=`<div class="poster-wrap"><span class="badge-year">${esc(item.anio||'N/D')}</span><span class="badge-type">${tipo==='serie'?'SERIE':'PELÍCULA'}</span><img class="poster" src="${esc(item.portada||PLACEHOLDER)}" loading="lazy" alt="${esc(item.titulo)}" onerror="this.onerror=null;this.src='${PLACEHOLDER}'"><div class="card-actions"><button class="fav-btn" title="Favorito" aria-label="Agregar a favoritos"><i class="fa-solid fa-heart"></i></button><button class="list-btn" title="Mi lista" aria-label="Agregar a mi lista"><i class="fa-solid fa-plus"></i></button></div></div><div class="info"><h4>${esc(item.titulo)}</h4><div class="meta"><span class="rating">★ ${esc(item.puntuacion||'N/A')}</span><span>${esc(item.anio||'')}</span></div></div>`;
div.querySelector('.fav-btn').addEventListener('click',e=>{e.stopPropagation();toggleFavorito({...item,id,tmdb_id:id,tipo});});div.querySelector('.list-btn').addEventListener('click',e=>{e.stopPropagation();toggleMiLista({...item,id,tmdb_id:id,tipo});});div.addEventListener('click',()=>{if(!auth.currentUser){irALogin();return;}location.href='reproductor.html?'+new URLSearchParams({play:id,tipo});});return div;}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function renderCards(container,items,tipo='pelicula',grid=false){container.innerHTML='';if(!items?.length){container.innerHTML='<p class="empty-msg">No se encontró contenido.</p>';return;}items.forEach(x=>container.appendChild(crearTarjeta(x,tipo==='serie')));}
async function cargarInicio(){
  try {
    const [pelis, series, estrenos] = await Promise.all([
      fetchTMDB('movie/popular', {page:1}),
      fetchTMDB('tv/popular', {page:1}),
      fetchTMDB('movie/upcoming', {page:1})
    ]);
    const popularesPelis = (pelis.results || []).map(x => itemDesdeTMDB(x, 'pelicula'));
    const popularesSeries = (series.results || []).map(x => itemDesdeTMDB(x, 'serie'));
    const proximos = (estrenos.results || []).map(x => itemDesdeTMDB(x, 'pelicula'));
    heroItems = proximos.slice(0, 8).length ? proximos.slice(0, 8) : popularesPelis.slice(0, 8);
    if (heroItems.length) iniciarHero();
    renderCards(document.getElementById('tendenciasContainer'), popularesPelis.slice(0, 15));
    renderCards(document.getElementById('estrenosContainer'), proximos.slice(0, 15));
    renderCards(document.getElementById('peliculasPopulares'), popularesPelis.slice(0, 15));
    renderCards(document.getElementById('seriesPopulares'), popularesSeries.slice(0, 15), 'serie');
  } catch(e) {
    console.error('Error cargando inicio:', e);
    ['tendenciasContainer','estrenosContainer','peliculasPopulares','seriesPopulares'].forEach(id => {
      const el = document.getElementById(id);
      if (el && el.querySelector('.empty-msg')) el.innerHTML = '<p class="empty-msg">No se pudo cargar. Revisa la conexión e inténtalo de nuevo.</p>';
    });
    mostrarToast('No se pudo cargar el catálogo. Revisa la API de TMDB.', 'error');
  }
}
function iniciarHero(){if(!heroItems.length)return;clearInterval(heroTimer);heroIndex=0;actualizarHero();heroTimer=setInterval(()=>{heroIndex=(heroIndex+1)%heroItems.length;actualizarHero();},6500);}
function actualizarHero(){peliculaHero=heroItems[heroIndex];if(!peliculaHero)return;const img=document.getElementById('heroImage');img.style.opacity='.2';setTimeout(()=>{img.src=peliculaHero.fondo||peliculaHero.portada;img.alt=peliculaHero.titulo;img.style.opacity='.76';},120);document.getElementById('heroTitle').textContent=peliculaHero.titulo;document.getElementById('heroOverview').textContent=peliculaHero.overview||'Descubre esta historia y muchas más en TELY.';document.getElementById('heroPlay').innerHTML='<i class="fa-solid fa-play"></i> Ver detalles';const dots=document.getElementById('heroDots');dots.innerHTML='';heroItems.slice(0,8).forEach((_,i)=>{const b=document.createElement('button');b.className='hero-dot'+(i===heroIndex?' active':'');b.setAttribute('aria-label','Ver destacado '+(i+1));b.onclick=()=>{heroIndex=i;actualizarHero();clearInterval(heroTimer);heroTimer=setInterval(()=>{heroIndex=(heroIndex+1)%heroItems.length;actualizarHero();},6500);};dots.appendChild(b);});}
function reproducirHero(){if(!peliculaHero)return;if(!auth.currentUser){irALogin();return;}location.href='reproductor.html?'+new URLSearchParams({play:peliculaHero.tmdb_id,tipo:peliculaHero.tipo});}
function agregarHeroLista(){if(peliculaHero)toggleMiLista(peliculaHero);}
async function cargarPeliculas(page=1){if(cargandoPeliculas)return;cargandoPeliculas=true;const grid=document.getElementById('gridPeliculas'),btn=document.getElementById('btnMasPeliculas');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Cargando';if(page===1)grid.innerHTML='';try{const data=await fetchTMDB(peliculasEndpoint,{page});totalPaginasPeliculas=data.total_pages||1;const items=(data.results||[]).map(x=>itemDesdeTMDB(x));if(page===1)grid.innerHTML='';items.forEach(x=>grid.appendChild(crearTarjeta(x)));paginaPeliculas=page;btn.style.display=page>=totalPaginasPeliculas?'none':'inline-flex';btn.innerHTML='Cargar más <i class="fa-solid fa-arrow-down"></i>';}catch(e){console.error(e);btn.innerHTML='Reintentar';mostrarToast('Error cargando películas','error');}finally{cargandoPeliculas=false;btn.disabled=false;}}
async function cargarSeries(page=1){if(cargandoSeries)return;cargandoSeries=true;const grid=document.getElementById('gridSeries'),btn=document.getElementById('btnMasSeries');btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Cargando';if(page===1)grid.innerHTML='';try{const data=await fetchTMDB(seriesEndpoint,{page});totalPaginasSeries=data.total_pages||1;(data.results||[]).map(x=>itemDesdeTMDB(x,'serie')).forEach(x=>grid.appendChild(crearTarjeta(x,true)));paginaSeries=page;btn.style.display=page>=totalPaginasSeries?'none':'inline-flex';btn.innerHTML='Cargar más <i class="fa-solid fa-arrow-down"></i>';}catch(e){console.error(e);btn.innerHTML='Reintentar';mostrarToast('Error cargando series','error');}finally{cargandoSeries=false;btn.disabled=false;}}
function cargarMasPeliculas(){if(!cargandoPeliculas)cargarPeliculas(paginaPeliculas+1);}
function cargarMasSeries(){if(!cargandoSeries)cargarSeries(paginaSeries+1);}
function filtrarGenero(btn,tipo,endpoint){btn.parentElement.querySelectorAll('.genre-chip').forEach(x=>x.classList.remove('active'));btn.classList.add('active');if(tipo==='movie'){peliculasEndpoint='movie/'+endpoint;paginaPeliculas=1;cargarPeliculas(1);}else{seriesEndpoint='tv/'+endpoint;paginaSeries=1;cargarSeries(1);}}
async function cargarCategoria(tipo,endpoint){if(tipo==='movie'){cambiarTab('peliculas');peliculasEndpoint='movie/'+endpoint;document.querySelectorAll('#tabPeliculas .genre-chip').forEach(x=>x.classList.toggle('active',x.textContent.toLowerCase().includes(endpoint.replace('_',' '))));paginaPeliculas=1;cargarPeliculas(1);}else{cambiarTab('series');seriesEndpoint='tv/'+endpoint;paginaSeries=1;cargarSeries(1);}}
function toggleFavorito(item){if(!auth.currentUser){irALogin();return;}const uid=auth.currentUser.uid,ref=db.ref(`usuarios/${uid}/favoritos/${item.id}`);ref.once('value').then(s=>{if(s.exists()){ref.remove();mostrarToast('Quitado de favoritos','info');}else{ref.set({id:item.id,titulo:item.titulo,tipo:item.tipo||'pelicula',portada:item.portada,tmdb_id:item.tmdb_id||item.id});mostrarToast('Añadido a favoritos');}}).catch(()=>mostrarToast('No se pudo actualizar','error'));}
function toggleMiLista(item){if(!auth.currentUser){irALogin();return;}const uid=auth.currentUser.uid,ref=db.ref(`usuarios/${uid}/milista/${item.id}`);ref.once('value').then(s=>{if(s.exists()){ref.remove();mostrarToast('Quitado de Mi lista','info');}else{ref.set({id:item.id,titulo:item.titulo,tipo:item.tipo||'pelicula',portada:item.portada,tmdb_id:item.tmdb_id||item.id});mostrarToast('Guardado en Mi lista');}}).catch(()=>mostrarToast('No se pudo actualizar','error'));}
function renderSaved(container,data){container.innerHTML='';if(!data||!Object.keys(data).length){container.innerHTML='<p class="empty-msg">Todavía no tienes contenido guardado.</p>';return;}Object.values(data).forEach(item=>{const card=crearTarjeta({...item,portada:item.portada||PLACEHOLDER},item.tipo==='serie');container.appendChild(card);});}
function cargarFavoritos(){if(!auth.currentUser)return;db.ref(`usuarios/${auth.currentUser.uid}/favoritos`).off();db.ref(`usuarios/${auth.currentUser.uid}/favoritos`).on('value',snap=>renderSaved(document.getElementById('favoritosContainer'),snap.val()));}
function cargarMiLista(){if(!auth.currentUser)return;db.ref(`usuarios/${auth.currentUser.uid}/milista`).off();db.ref(`usuarios/${auth.currentUser.uid}/milista`).on('value',snap=>renderSaved(document.getElementById('miListaContainer'),snap.val()));}
window.buscarGlobal=function(){const input=document.getElementById('searchInput'),clear=document.getElementById('searchClear'),texto=input.value.trim();clear.style.display=texto?'block':'none';clearTimeout(timeoutBusqueda);if(!texto){busquedaActiva=false;if(document.getElementById('tabPeliculas').style.display!=='none'){paginaPeliculas=1;cargarPeliculas(1);}else if(document.getElementById('tabSeries').style.display!=='none'){paginaSeries=1;cargarSeries(1);}else cargarInicio();return;}timeoutBusqueda=setTimeout(async()=>{busquedaActiva=true;const tab=document.getElementById('tabPeliculas').style.display!=='none'?'peliculas':document.getElementById('tabSeries').style.display!=='none'?'series':'inicio';try{if(tab==='peliculas'||tab==='series'){const isMovie=tab==='peliculas',grid=document.getElementById(isMovie?'gridPeliculas':'gridSeries'),btn=document.getElementById(isMovie?'btnMasPeliculas':'btnMasSeries');grid.innerHTML='<p class="empty-msg">Buscando…</p>';const data=await fetchTMDB(isMovie?'search/movie':'search/tv',{query:text,page:1});grid.innerHTML='';(data.results||[]).forEach(x=>grid.appendChild(crearTarjeta(itemDesdeTMDB(x,isMovie?'pelicula':'serie'),!isMovie)));if(!grid.children.length)grid.innerHTML='<p class="empty-msg">No se encontraron resultados.</p>';btn.style.display='none';}else{const [p,s]=await Promise.all([fetchTMDB('search/movie',{query:text,page:1}),fetchTMDB('search/tv',{query:text,page:1})]);const tc=document.getElementById('tendenciasContainer'),pc=document.getElementById('peliculasPopulares'),sc=document.getElementById('seriesPopulares');renderCards(tc,(p.results||[]).slice(0,12).map(x=>itemDesdeTMDB(x)));renderCards(pc,(p.results||[]).slice(0,12).map(x=>itemDesdeTMDB(x)));renderCards(sc,(s.results||[]).slice(0,12).map(x=>itemDesdeTMDB(x,'serie')));document.getElementById('heroTitle').textContent='Resultados para “'+texto+'”';document.getElementById('heroOverview').textContent='Explora las películas y series que coinciden con tu búsqueda.';}}catch(e){console.error(e);mostrarToast('No se pudo completar la búsqueda','error');}},400);};
function limpiarBusqueda(){document.getElementById('searchInput').value='';buscarGlobal();document.getElementById('searchInput').focus();}
document.getElementById('mainContent').addEventListener('scroll',()=>{clearTimeout(scrollTimeout);scrollTimeout=setTimeout(()=>{const main=document.getElementById('mainContent');if(main.scrollTop+main.clientHeight>=main.scrollHeight-180){if(document.getElementById('tabPeliculas').style.display!=='none'&&!cargandoPeliculas&&paginaPeliculas<totalPaginasPeliculas)cargarMasPeliculas();if(document.getElementById('tabSeries').style.display!=='none'&&!cargandoSeries&&paginaSeries<totalPaginasSeries)cargarMasSeries();}guardarScroll();},150);});
function detectarPlataforma(){const ua=navigator.userAgent||'';return{esNavegador:/Android|iPhone|iPad|iPod/i.test(ua)&&!(/wv|WebView|Android.*(wv|WebView)/i.test(ua))};}
function mostrarBannerApp(){const b=document.getElementById('bannerApp');if(!b||localStorage.getItem('bannerAppCerrado')==='true')return;if(detectarPlataforma().esNavegador){b.style.display='block';}}
function cerrarBannerApp(){document.getElementById('bannerApp').style.display='none';localStorage.setItem('bannerAppCerrado','true');}
function descargarAPK(){const url='https://tely-xi.vercel.app';mostrarToast('Abriendo TELY…','info');window.open(url,'_blank','noopener');}
document.addEventListener('DOMContentLoaded',()=>{
  const tab = restaurarEstado();
  cambiarTab(tab);
  setTimeout(mostrarBannerApp, 2500);
  setTimeout(restaurarScroll, 200);
  // Precarga el catálogo como en el original, sin bloquear la interfaz.
  cargarInicio();
  cargarPeliculas(1);
  cargarSeries(1);
});
console.log('TELY — interfaz móvil premium cargada');
</script>
